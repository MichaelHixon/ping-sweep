# compiled binaries — build locally, don't commit
c/ping-sweep
rust/ping-sweep
go/ping-sweep
nim/ping-sweep
*.o
*.out

# OS
.DS_Store

# Claude Code local config — machine-local settings stay out.
# settings.json is the exception: shared build/test permissions, no paths, no identity.
# The /* form is required: git cannot re-include a file under an excluded directory.
.claude/*
!.claude/settings.json

# Python bytecode
__pycache__/
